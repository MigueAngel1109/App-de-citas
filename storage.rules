rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura de fotos a cualquiera (o usuarios autenticados) para que se visualicen sin problemas
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regla general para el resto de archivos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
