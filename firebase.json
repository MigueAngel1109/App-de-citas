{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "citaapp-19692",
          "appId": "1:805368861395:android:c40fab96f77e305d517a26",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "citaapp-19692",
          "configurations": {
            "android": "1:805368861395:android:c40fab96f77e305d517a26",
            "ios": "1:805368861395:ios:7e049f0576848782517a26",
            "macos": "1:805368861395:ios:7e049f0576848782517a26",
            "web": "1:805368861395:web:3cb5466d1b97a0dd517a26",
            "windows": "1:805368861395:web:72d56551c929fcfb517a26"
          }
        }
      }
    }
  }
}